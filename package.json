{
  "name": "senzilytics",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "permissions:moc": "tsx --env-file=.env prisma/grant-moc-permissions.ts",
    "start": "next start",
    "lint": "eslint",
    "test": "node scripts/run-tests.mjs",
    "check": "npm run lint && npm test && npm run build",
    "verify:production": "tsx --env-file=.env scripts/verify-production-env.ts",
    "db:deploy": "prisma migrate deploy",
    "platform:grant": "tsx --env-file=.env scripts/grant-platform-admin.ts",
    "password:reset": "tsx --env-file=.env scripts/reset-user-password.ts",
    "demo:seed": "tsx --env-file=.env scripts/seed-public-demo.ts",
    "mobile:install": "npm --prefix apps/mobile install",
    "mobile:check": "npm --prefix apps/mobile run check",
    "postinstall": "prisma generate",
    "repair:workflows": "tsx prisma/repair-workflows.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.4.0",
    "@prisma/adapter-pg": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "@vercel/blob": "^2.6.1",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "jszip": "^3.10.1",
    "lucide-react": "^1.23.0",
    "next": "16.2.12",
    "next-auth": "^5.0.0-beta.32",
    "openai": "^6.46.0",
    "pg": "^8.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.81.0",
    "recharts": "^3.9.2",
    "resend": "^6.17.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "prisma": "^7.9.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5"
  },
  "overrides": {
    "find-my-way": "^9.7.0",
    "minimatch@3.1.5": {
      "brace-expansion": "1.1.18"
    },
    "minimatch@10.2.5": {
      "brace-expansion": "5.0.9"
    },
    "deepmerge-ts": "8.0.2",
    "fast-uri": "3.1.7",
    "mysql2": "3.24.3",
    "nanoid": "3.3.18",
    "undici": "6.28.0",
    "uuid": "11.1.1",
    "postcss": "^8.5.23",
    "sharp": "^0.35.3",
    "valibot": "^1.4.2"
  }
}
